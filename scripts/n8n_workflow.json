          "assignments": [
            {"name": "status", "value": "ok", "type": "string"},
            {"name": "message", "value": "alerte recue", "type": "string"},
            {"name": "summary", "value": "={{$json.response}}", "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "5",
