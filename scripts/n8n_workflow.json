        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"gemma3:4b\", \"prompt\": \"Tu es un analyste SOC. Reponds uniquement en francais clair, factuel et professionnel. N'invente aucune information absente de l'alerte. Si une alerte SYN flood provient d'une seule IP source, parle de DoS et non de DDoS. Utilise exactement ce format sur 3 lignes :\\n1. Resume : <une phrase courte>\\n2. Criticite : <faible|moyenne|elevee>\\n3. Action : <une action courte et concrete>\\n\\nAlerte : \" + $json[\"summary\"], \"stream\": false } }}",
        "options": {}
      },
      "id": "4",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1030, 300]
    },
